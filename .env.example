# Copy to .env and fill in. The server refuses to start if a required value is missing.

# --- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/smart_depannage"

# Two DIFFERENT random values, 32+ characters in production.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Public URL of the website (no trailing slash). Used in the links sent to users
# (password reset, tracking). Use https:// in production.
FRONTEND_URL=http://localhost:3001

# --- Optional ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Extra browser origins allowed by CORS, comma separated (e.g. the admin dashboard).
# Localhost ports 3000-3002 are allowed automatically outside production.
CORS_ORIGINS=

# Number of reverse proxies in front of the API (nginx, load balancer...).
# Needed so rate limits see the real client IP; without it every visitor shares
# the proxy's address. Leave empty (or "false") when the API is exposed directly.
TRUST_PROXY=

# E-mails are only logged for now (no mail provider). Outside production the
# body of each mail is logged, links included. In production it is hidden unless
# this is "true" (a logged link is a password: turn it on only to debug).
LOG_EMAIL_BODIES=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Seed (npm run seed / prisma db seed) -------------------------------------
# Password given to the demo accounts. If empty, a random one is generated and
# printed once. In production it must be set explicitly.
SEED_PASSWORD=
