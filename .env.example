# Copy to .env and fill in. The server refuses to start if a required value is missing.

# --- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/smart_depannage"

# Two DIFFERENT random values, 32+ characters in production.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Public URL of the WEBSITE (no trailing slash), not of this API (PORT below):
# the website runs on 3001 in development, the admin dashboard on 3002.
# Used in the links sent to users (password reset, tracking). Use https:// in production.
FRONTEND_URL=http://localhost:3001

# --- Optional ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Extra browser origins allowed by CORS, comma separated (e.g. the admin dashboard).
# Localhost ports 3000-3002 are allowed automatically outside production.
CORS_ORIGINS=

# Number of reverse proxies in front of the API (nginx, load balancer...).
# Needed so rate limits see the real client IP; without it every visitor shares
# the proxy's address. Leave empty (or "false") when the API is exposed directly.
TRUST_PROXY=

# --- Delivery of e-mail, SMS and push (P1-03) ---------------------------------
# Every message goes through an outbox table and a worker that retries. A channel
# without a provider does not send: the message is marked FAILED and the server
# says so at start-up. Messages are never written to the log (a logged code or
# link would be a password).

# SMS: none (default) | twilio | http (any gateway with a JSON API)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
SMS_HTTP_URL=
SMS_HTTP_AUTH_HEADER=
SMS_HTTP_FROM=
# Added to national numbers (216 = Tunisia).
DEFAULT_PHONE_COUNTRY_CODE=216
# Phone that gets an SMS for every new request. Empty = nobody is texted.
ADMIN_ALERT_PHONE=

# E-mail over SMTP. Leave SMTP_HOST empty for no e-mail.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); empty = true only on 465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Dépannage <no-reply@example.tn>"

# Push to the mobile app through Expo: expo (default) | none.
PUSH_PROVIDER=
# Only if the Expo project requires an access token for push.
EXPO_ACCESS_TOKEN=

# off (or false, 0): this process sends nothing and does not retry, messages wait in the
# outbox for a process that has the worker on. Default on. Tries before giving up:
OUTBOX_WORKER=
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_MS=15000

# Development only, ignored in production: "true" prints the text of messages that
# cannot be sent because no provider is configured, so a flow can be tried.
DELIVERY_DEBUG_LOG=

# Which spelling of the intervention statuses is written to the database:
# "legacy" (default, what the admin, mobile and website apps understand today)
# or "canonical". Switch only after those apps are updated and after running
# npm run status:migrate-vocabulary -- --apply (see scripts/migrate-status-vocabulary.ts).
STATUS_STORAGE=

# The time zone in which the artisans' weekly hours ("Monday 08:00-17:00") are written
# and appointments are read: an IANA name. Empty means Africa/Tunis (P1-05).
BUSINESS_TIMEZONE=

# --- Proof of work (P1-07) ---------------------------------------------------
# What the server does with the position and the photo of a before/after proof. Empty means
# the default; a value that makes no sense is ignored.
# A photo taken farther than this from the job (metres, once the GPS accuracy up to 100 m is
# excused) is kept but a person of the back office is asked to look at it. Default 300.
PROOF_REVIEW_DISTANCE_M=
# Farther than this the photo is refused and the artisan retakes it. Default 2000.
PROOF_REJECT_DISTANCE_M=
# A GPS fix less sure than this (metres) is looked at / refused. Defaults 100 and 1000.
PROOF_POOR_ACCURACY_M=
PROOF_REJECT_ACCURACY_M=
# The phone's clock may differ from the server's by this many minutes. Default 15.
PROOF_CLOCK_TOLERANCE_MINUTES=
# Two photos whose "look" hashes differ by this many bits or fewer (of 64) are the same
# picture; the second is looked at. Default 4.
PROOF_SIMILARITY_BITS=
# true: a phone that does not say how sure its position is, or whether it is simulated, is
# looked at (the app of today does not say). Default false.
PROOF_REQUIRE_GPS_QUALITY=
# true: a photo of a job that has no coordinates is looked at too. Default false: it is only
# noted, since most jobs made on the website have none.
PROOF_REVIEW_UNLOCATED=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Seed (npm run seed / prisma db seed) -------------------------------------
# Password given to the demo accounts. If empty, a random one is generated and
# printed once. In production it must be set explicitly.
SEED_PASSWORD=
