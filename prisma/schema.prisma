  afterPhotoUrl String?
  afterPhotoLat Float?
  afterPhotoLng Float?
  afterPhotoAt  DateTime?

  trackingToken String @unique

  rating        Int?
  isOnTime      Boolean?
  hasIssue      Boolean @default(false)
  feedbackNotes String?

  requestCreatedAt          DateTime?
  adminReviewStartedAt      DateTime?
  quoteSentAt               DateTime?
  quoteAcceptedAt           DateTime?
  assignedAt                DateTime?
  waitingClientValidationAt DateTime?
  clientValidatedAt         DateTime?
  paymentPendingAt          DateTime?
  paidAt                    DateTime?
  invoiceSentAt             DateTime?

  artisanAcceptedAt DateTime?
  artisanRejectedAt DateTime?
  artisanOnTheWayAt DateTime?
  artisanArrivedAt  DateTime?
  workStartedAt     DateTime?
  workCompletedAt   DateTime?
  cancelledAt       DateTime?

  diagnosticNotes String?
  materialUsed    Json?

  extraQuoteRequested Boolean @default(false)
  extraQuoteReason    String?

  clientSignatureUrl String?
  clientSignatureAt  DateTime?

  problemReported Boolean             @default(false)
  problemType     MissionProblemType?
  problemNotes    String?

  lastStatusChangedAt DateTime?

  adminInternalNotes String?
  cancelledReason    String?
  cancelledById      Int?

  events     InterventionEvent[]
  quotes     Quote[]
  payments   Payment[]
  // A job can have several invoices over time (a cancelled or credited one, then the one that replaces it): the one that counts is the latest that is not cancelled (P2-07).
