// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Enums for your specific business logic
enum Role {
  CLIENT
  ARTISAN
  ADMIN
}

enum ServiceType {
  PLOMBIER
  MENUISIER
  SERRURIER
  ELECTRICIEN
  AUTRE
}

enum Status {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Models
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  phone     String?
  
  // ✅ NOUVEAUX CHAMPS (Ajoutés pour la gestion du profil/entreprise)
  address   String?  // Adresse du siège ou domicile
  taxId     String?  // Matricule Fiscale
  website   String?  // Site Web

  latitude  Float?   // Latitude GPS (ex: 36.8065)
  longitude Float?   // Longitude GPS (ex: 10.1815)
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  
  // Relations
  clientInterventions  Intervention[] @relation("ClientInterventions")
  artisanInterventions Intervention[] @relation("ArtisanInterventions")
}

model Intervention {
  id          Int         @id @default(autoincrement())
  description String
  address     String
  serviceType ServiceType
  status      Status      @default(PENDING)
  
  // Relations
  clientId    Int
  client      User        @relation("ClientInterventions", fields: [clientId], references: [id])
  
  artisanId   Int?
  artisan     User?       @relation("ArtisanInterventions", fields: [artisanId], references: [id])
  
  // Array of URLs for the initial damage photos uploaded by the Client
  photos         String[]  

  // Tamper-Proof "Before" Photo Data (Uploaded by Artisan)
  beforePhotoUrl String?
  beforePhotoLat Float?
  beforePhotoLng Float?
  beforePhotoAt  DateTime?

  // Tamper-Proof "After" Photo Data (Uploaded by Artisan)
  afterPhotoUrl  String?
  afterPhotoLat  Float?
  afterPhotoLng  Float?
  afterPhotoAt   DateTime?

  // NEW: Security & Tracking
  // Stores the hashed token to secure the public tracking link
  trackingToken  String   @unique 

  // NEW: User Feedback & Complaints (Filled out after status == COMPLETED)
  rating         Int?     // 1 to 5 stars
  isOnTime       Boolean? // Did the artisan arrive when expected?
  hasIssue       Boolean  @default(false) // True if the user complains
  feedbackNotes  String?  // Text description of the complaint or praise

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ArtisanApplication {
  id          Int               @id @default(autoincrement())
  name        String
  email       String            @unique
  phone       String
  specialty   String            // e.g. "Plombier", "Menuisier"
  experience  Int               // Years of experience
  description String?           // Optional "About me"
  
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}