model Notification {
  id Int @id @default(autoincrement())

  recipientId Int
  recipient   User @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId Int?
  actor   User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  type     NotificationType
  priority NotificationPriority @default(NORMAL)

  title   String
  message String

  channels NotificationChannel[]

  entityType String?
  entityId   Int?

  data Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries NotificationDeliveryLog[]

  @@index([recipientId])
  @@index([actorId])
  @@index([type])
  @@index([priority])
  @@index([entityType])
  @@index([entityId])
  @@index([entityType, entityId])
  @@index([isRead])
  @@index([deletedAt])
  @@index([createdAt])
}

model NotificationDeliveryLog {
  id Int @id @default(autoincrement())

  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  channel NotificationChannel
  status  NotificationDeliveryStatus @default(PENDING)

  destination String?

  provider          String?
  providerMessageId String?

  error String?

  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([notificationId])
  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([destination])
  @@index([sentAt])
  @@index([createdAt])
}

model PushDeviceToken {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique

  platform   String?
  deviceId   String?
  deviceName String?

  isActive Boolean @default(true)

  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@index([platform])
  @@index([isActive])
  @@index([lastUsedAt])
}

// ==========================================================
// Outbox (P1-03)
// Every e-mail, SMS and push goes through this table: the request that caused
// it writes a row and returns, a worker sends it and retries with a growing
// delay. `body` and `subject` are emptied once the message is sent or has failed
// for good, so one-time codes and links do not stay in the database.
// No relations on purpose: it is an operational queue, not business data.
// ==========================================================

model NotificationOutbox {
  id Int @id @default(autoincrement())

  channel NotificationChannel
  status  OutboxStatus        @default(PENDING)

  userId         Int?
  notificationId Int?
  deliveryLogId  Int?

  recipient String?
  subject   String?
  body      String  @default("")
  data      Json?

  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?

  // A code or link is useless once it has expired: after this time the message
  // is not sent any more. supersedeKey: a newer message with the same key
  // cancels the ones still waiting (a second "send me a code" replaces the first).
  expiresAt    DateTime?
  supersedeKey String?

  provider          String?
  providerMessageId String?
  lastError         String?
  sentAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([supersedeKey, status])
  @@index([userId])
  @@index([createdAt])
}

// ==========================================================
// Proof of work (P1-07)
// Every photo an artisan (or the back office) puts on a job as its "before" or "after"
// proof goes through ProofsService, which writes one row here per attempt: where the phone
// said it was and how sure it was, whether it said the position was simulated, when the
// SERVER received the photo, what the photo is (SHA-256 of its bytes, a "looks like" hash)
// and the verdict. A refused attempt is kept (without the photo) so the audit shows it.
// `sha256` is only set for photos that were kept, and is unique: the same photo cannot be
// the proof of two jobs. The columns afterPhoto* / beforePhoto* of Intervention are the
// copy of the latest kept proof, written by the same transaction.
// No relations on purpose, like the outbox: an audit trail that outlives what it describes.
// ==========================================================

enum ProofKind {
  BEFORE
  AFTER
}

enum ProofSource {
  ARTISAN
  STAFF
}

enum ProofStatus {
  ACCEPTED
  NEEDS_REVIEW
  REJECTED
}

model ProofCapture {
  id Int @id @default(autoincrement())

  interventionId Int
  kind           ProofKind
  source         ProofSource @default(ARTISAN)
  submittedById  Int?

  status  ProofStatus
  reasons String[]

  // What the phone said.
  latitude         Float?
  longitude        Float?
  accuracyM        Float?
  mocked           Boolean?
  clientCapturedAt DateTime?

  // What the server worked out. `receivedAt` is the time of the proof.
  distanceM          Int?
  clockOffsetSeconds Int?
  receivedAt         DateTime @default(now())

  // The photo (none when the attempt was refused).
  fileAssetId Int?
  photoUrl    String?
  sha256      String? @unique
  dhash       String?
  detail      Float?

  // A person of the back office looked at it.
  reviewedById Int?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())

  @@index([interventionId, kind])
  @@index([status, createdAt])
  @@index([submittedById])
  @@index([fileAssetId])
  @@index([createdAt])
}

