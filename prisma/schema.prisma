  artisanOnTheWay            Boolean @default(true)
  artisanArrived             Boolean @default(true)
  workStarted                Boolean @default(true)
  workCompleted              Boolean @default(true)
  quoteSent                  Boolean @default(true)
  quoteAccepted              Boolean @default(true)
  paymentReceived            Boolean @default(true)
