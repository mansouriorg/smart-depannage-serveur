  savedAddressId Int?
  savedAddress   ClientAddress? @relation(fields: [savedAddressId], references: [id])

  latitude  Float?
  longitude Float?

  preferredDate      DateTime?
  preferredStartTime String?
  preferredEndTime   String?

  contactName  String?
  contactPhone String?
  contactEmail String?

  accessInstructions String?
  buildingInfo       String?
  floor              String?
  apartmentCode      String?

  clientId Int
  client   User @relation("ClientInterventions", fields: [clientId], references: [id])

  artisanId Int?
  artisan   User? @relation("ArtisanInterventions", fields: [artisanId], references: [id])

  photos String[]

  beforePhotoUrl String?
  beforePhotoLat Float?
  beforePhotoLng Float?
