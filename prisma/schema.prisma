// ==========================================================
// Models
// ==========================================================

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String

  name  String?
  phone String?
  // The number in one canonical spelling (E.164, "+21622123456"), so "22 123 456" and
  // "+216 22123456" are the same number. Unique: a number belongs to one account.
  // Written together with `phone` by phoneColumns() (src/common/contact/phone.ts),
  // never by hand. Null when there is no number, or for the rare row that lost a
  // duplicate during scripts/backfill-phone-keys.ts.
  phoneKey String? @unique

  address String?
  taxId   String?
  website String?

  latitude  Float?
  longitude Float?
  // When the phone last said where it was (P3-05): the position above is as old as this. Null for a position nobody has sent.
  positionAt DateTime?

  role     Role    @default(CLIENT)
  isActive Boolean @default(true)

  isGuest          Boolean   @default(false)
  guestActivatedAt DateTime?

  // The language of the messages sent to this person and of what the apps show them: "fr" or "ar" (P3-04). Kept as text, not an
  // enum: the shared package owns the list of languages and the code reads it with localeOf(). French for everybody until they choose;
  // staff are always written to in French whatever this says.
  locale String @default("fr")

  deletedAt DateTime?

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  passwordChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientInterventions  Intervention[] @relation("ClientInterventions")
  artisanInterventions Intervention[] @relation("ArtisanInterventions")

  // The positions a technician's phone sent over the last days (P3-05).
  locationPings ArtisanLocationPing[]

  artisanProfile ArtisanProfile?

  authTokens AuthToken[]

  clientAddresses        ClientAddress[]
  notificationPreference NotificationPreference?

  sentMessages Message[] @relation("SentMessages")
  complaints   Complaint[]

  assignedComplaints Complaint[]        @relation("AssignedComplaints")
  complaintMessages  ComplaintMessage[] @relation("ComplaintMessageAuthor")

  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")

  quotesCreated Quote[] @relation("QuotesCreated")

  uploadedFiles FileAsset[] @relation("UploadedFiles")

  notifications      Notification[] @relation("UserNotifications")
  notificationsActed Notification[] @relation("NotificationActor")
  notificationLogs   NotificationDeliveryLog[]
  pushTokens         PushDeviceToken[]

  clientAppointments  Appointment[]     @relation("ClientAppointments")
  artisanAppointments Appointment[]     @relation("ArtisanAppointments")
  artisanTimeBlocks   ArtisanTimeBlock[] @relation("ArtisanTimeBlocks")

  artisanPayouts           ArtisanPayout[]    @relation("ArtisanPayouts")
  cashLedgerEntries        CashLedgerEntry[]  @relation("ArtisanCashLedger")
  businessReportsCreated   BusinessReport[]   @relation("BusinessReportsCreated")
  accountingExportsCreated AccountingExport[] @relation("AccountingExportsCreated")

  @@index([role])
  @@index([isActive])
  @@index([isGuest])
  @@index([deletedAt])
  @@index([phone])
}

model AuthToken {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AuthTokenType
  tokenHash String        @unique

  // EMAIL_CHANGE / PHONE_CHANGE: the address or number the person asked for.
  // It only replaces the one on the account once they prove they own it.
  newValue String?

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, type])
  @@index([type])
  @@index([expiresAt])
}

// ==========================================================
// Client Account Features
// ==========================================================

model ClientAddress {
  id       Int  @id @default(autoincrement())
