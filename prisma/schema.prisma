// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}
// ==========================================================
// Enums
// ==========================================================

enum Role {
  CLIENT
  ARTISAN
  ADMIN
  SUPER_ADMIN
  SUPPORT
  DISPATCHER
  ACCOUNTANT
}

enum ServiceType {
  PLOMBIER
  MENUISIER
  SERRURIER
  ELECTRICIEN
  AUTRE
}

enum Status {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuthTokenType {
  REFRESH
  PASSWORD_RESET
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

// ==========================================================
// Models
// ==========================================================

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password  String
  name      String?
  phone     String?

  // Profile / company information
  address   String?
  taxId     String?
  website   String?

  // GPS location, useful especially for artisans
  latitude  Float?
  longitude Float?

  // Role and account status
  role      Role    @default(CLIENT)
  isActive  Boolean @default(true)

  // Soft delete / account deactivation
  deletedAt DateTime?

  // Verification fields
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  // Security tracking
  passwordChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  clientInterventions  Intervention[] @relation("ClientInterventions")
  artisanInterventions Intervention[] @relation("ArtisanInterventions")

  authTokens AuthToken[]

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@index([phone])
}

model AuthToken {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AuthTokenType
  tokenHash String        @unique

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, type])
  @@index([type])
  @@index([expiresAt])
}

model Intervention {
  id          Int         @id @default(autoincrement())
  description String
  address     String
  serviceType ServiceType
  status      Status      @default(PENDING)

  // Client relation
  clientId Int
  client   User @relation("ClientInterventions", fields: [clientId], references: [id])

  // Artisan relation
  artisanId Int?
  artisan   User? @relation("ArtisanInterventions", fields: [artisanId], references: [id])

  // Initial damage photos uploaded by the client
  photos String[]

  // Tamper-proof before photo data uploaded by artisan
  beforePhotoUrl String?
  beforePhotoLat Float?
  beforePhotoLng Float?
  beforePhotoAt  DateTime?

  // Tamper-proof after photo data uploaded by artisan
  afterPhotoUrl String?
  afterPhotoLat Float?
  afterPhotoLng Float?
  afterPhotoAt  DateTime?

  // Public tracking security
  // Store only the hashed token, never the raw token
  trackingToken String @unique

  // User feedback and complaint fields
  rating        Int?
  isOnTime      Boolean?
  hasIssue      Boolean @default(false)
  feedbackNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([artisanId])
  @@index([status])
  @@index([serviceType])
  @@index([createdAt])
}

model ArtisanApplication {
  id          Int    @id @default(autoincrement())
  name        String
  email       String @unique
  phone       String
  specialty   String
  experience  Int
  description String?

  status ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}