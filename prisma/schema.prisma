// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}
// ==========================================================
// Enums
// ==========================================================

enum Role {
  CLIENT
  ARTISAN
  ADMIN
  SUPER_ADMIN
  SUPPORT
  DISPATCHER
  ACCOUNTANT
}

enum ServiceType {
  PLOMBIER
  MENUISIER
  SERRURIER
  ELECTRICIEN
  AUTRE
}

enum Status {
  // Professional workflow
  CREATED
  WAITING_ADMIN_REVIEW
  QUOTE_SENT
  QUOTE_ACCEPTED
  ASSIGNED
  ARTISAN_ACCEPTED
  ARTISAN_ON_THE_WAY
  ARTISAN_ARRIVED
  IN_PROGRESS
  WAITING_CLIENT_VALIDATION
  COMPLETED
  PAYMENT_PENDING
  PAID
  INVOICE_SENT
  CANCELLED
  DISPUTED

  // Old compatibility statuses
  PENDING
  ADMIN_REVIEW
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  INVOICE_READY
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuthTokenType {
  REFRESH
  PASSWORD_RESET
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  GUEST_MAGIC_LINK
  GUEST_OTP
}

enum UrgencyLevel {
  NORMAL
  URGENT
  EMERGENCY
}

enum InterventionEventType {
  REQUEST_CREATED
  ADMIN_REVIEWING
  QUOTE_SENT
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  QUOTE_MODIFICATION_REQUESTED

  ARTISAN_ASSIGNED
  ARTISAN_ACCEPTED
  ARTISAN_ON_THE_WAY
  ARTISAN_ARRIVED

  BEFORE_PHOTO_UPLOADED
  WORK_STARTED
  AFTER_PHOTO_UPLOADED
  WORK_COMPLETED

  CLIENT_VALIDATION_PENDING
  CLIENT_VALIDATED

  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  CLIENT_PAID

  INVOICE_READY
  INVOICE_SENT

  REVIEW_SUBMITTED
  ISSUE_REPORTED
  COMPLAINT_OPENED
  CANCELLED

  STATUS_CHANGED
  INTERNAL_NOTE_ADDED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  MODIFICATION_REQUESTED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  ONLINE_CARD
  CASH
  BANK_TRANSFER
}

enum PaymentProvider {
  MANUAL
  INTERNAL
  STRIPE
  PAYPAL
  KONNECT
  PAYMEE
  FLOUCI
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PAID
  CANCELLED
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  WAITING_CLIENT
  WAITING_ARTISAN
  RESOLVED
  REJECTED
  REFUNDED
}

enum MessageAudience {
  CLIENT_ARTISAN
  CLIENT_SUPPORT
  ARTISAN_SUPPORT
  INTERNAL_ADMIN
}

enum ArtisanVerificationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum ArtisanDocumentType {
  IDENTITY
  COMPANY_LEGAL
  INSURANCE
  CERTIFICATE
  PROFILE_PHOTO
  OTHER
}

enum ArtisanDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ArtisanAvailabilityStatus {
  ONLINE
  OFFLINE
  BUSY
  UNAVAILABLE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MissionRejectionReason {
  NOT_AVAILABLE
  TOO_FAR
  OUT_OF_SPECIALTY
  PRICE_TOO_LOW
  OTHER
}

enum MissionProblemType {
  CLIENT_ABSENT
  ACCESS_ISSUE
  EXTRA_WORK_REQUIRED
  SAFETY_RISK
  MATERIAL_MISSING
  CLIENT_DISPUTE
  OTHER
}

enum AdminNoteTargetType {
  INTERVENTION
  CLIENT
  ARTISAN
  COMPLAINT
  PAYMENT
  INVOICE
}

enum NotificationTemplateType {
  SMS
  EMAIL
  PUSH
}

// ==========================================================
// Models
// ==========================================================

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String

  name  String?
  phone String?

  // Profile / company information
  address String?
  taxId   String?
  website String?

  // GPS location, useful especially for artisans
  latitude  Float?
  longitude Float?

  // Role and account status
  role     Role    @default(CLIENT)
  isActive Boolean @default(true)

  // Guest account support
  // Guest users are created from public requests without usable password.
  // They can activate their account later with magic link / OTP.
  isGuest          Boolean   @default(false)
  guestActivatedAt DateTime?

  // Soft delete / account deactivation
  deletedAt DateTime?

  // Verification fields
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  // Security tracking
  passwordChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  clientInterventions  Intervention[] @relation("ClientInterventions")
  artisanInterventions Intervention[] @relation("ArtisanInterventions")

  artisanProfile ArtisanProfile?

  authTokens AuthToken[]

  clientAddresses        ClientAddress[]
  notificationPreference NotificationPreference?

  sentMessages Message[] @relation("SentMessages")
  complaints   Complaint[]

  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")

  quotesCreated Quote[] @relation("QuotesCreated")

  @@index([role])
  @@index([isActive])
  @@index([isGuest])
  @@index([deletedAt])
  @@index([phone])
}

model AuthToken {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AuthTokenType
  tokenHash String        @unique

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, type])
  @@index([type])
  @@index([expiresAt])
}

// ==========================================================
// Client Account Features
// ==========================================================

model ClientAddress {
  id       Int  @id @default(autoincrement())
  clientId Int
  client   User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  label      String?
  address    String
  city       String?
  postalCode String?
  latitude   Float?
  longitude  Float?

  buildingInfo       String?
  floor              String?
  apartmentCode      String?
  accessInstructions String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interventions Intervention[]

  @@index([clientId])
}

// ==========================================================
// Notification Preferences
// ==========================================================

model NotificationPreference {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(true)
  pushEnabled  Boolean @default(true)

  interventionUpdates Boolean @default(true)
  quoteUpdates        Boolean @default(true)
  paymentUpdates      Boolean @default(true)
  invoiceUpdates      Boolean @default(true)
  complaintUpdates    Boolean @default(true)
  marketingUpdates    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================================
// Service Catalog
// ==========================================================

model ServiceCategory {
  id          Int         @id @default(autoincrement())
  serviceType ServiceType @unique

  name        String
  description String?

  isActive Boolean @default(true)

  subServices SubService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceType])
  @@index([isActive])
  @@index([name])
}

model SubService {
  id         Int             @id @default(autoincrement())
  categoryId Int
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  description String?

  // Estimated duration in minutes.
  // Example: 60 = 1 hour.
  estimatedDuration Int?

  // Base intervention price.
  basePrice Float?

  // Emergency / urgent intervention price.
  emergencyPrice Float?

  // Should the client upload photos before submitting the request?
  requiresPhotos Boolean @default(false)

  isActive Boolean @default(true)

  interventions Intervention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([name])
  @@index([basePrice])
  @@index([emergencyPrice])
  @@index([estimatedDuration])
}

// ==========================================================
// Interventions
// ==========================================================

model Intervention {
  id          Int          @id @default(autoincrement())
  description String
  address     String
  serviceType ServiceType
  status      Status       @default(CREATED)
  urgency     UrgencyLevel @default(NORMAL)

  // Sub-service
  subServiceId Int?
  subService   SubService? @relation(fields: [subServiceId], references: [id])

  // Optional saved address used by client
  savedAddressId Int?
  savedAddress   ClientAddress? @relation(fields: [savedAddressId], references: [id])

  // GPS position of the intervention address
  latitude  Float?
  longitude Float?

  // Preferred appointment window
  preferredDate      DateTime?
  preferredStartTime String?
  preferredEndTime   String?

  // Contact information for this specific request
  contactName  String?
  contactPhone String?
  contactEmail String?

  // Access details
  accessInstructions String?
  buildingInfo       String?
  floor              String?
  apartmentCode      String?

  // Client relation
  clientId Int
  client   User @relation("ClientInterventions", fields: [clientId], references: [id])

  // Artisan relation
  artisanId Int?
  artisan   User? @relation("ArtisanInterventions", fields: [artisanId], references: [id])

  // Initial damage photos uploaded by client
  photos String[]

  // Tamper-proof before photo data uploaded by artisan
  beforePhotoUrl String?
  beforePhotoLat Float?
  beforePhotoLng Float?
  beforePhotoAt  DateTime?

  // Tamper-proof after photo data uploaded by artisan
  afterPhotoUrl String?
  afterPhotoLat Float?
  afterPhotoLng Float?
  afterPhotoAt  DateTime?

  // Public tracking security
  // Store only the hashed token, never the raw token
  trackingToken String @unique

  // User feedback and issue fields
  rating        Int?
  isOnTime      Boolean?
  hasIssue      Boolean @default(false)
  feedbackNotes String?

  // Professional workflow timestamps
  requestCreatedAt          DateTime?
  adminReviewStartedAt      DateTime?
  quoteSentAt               DateTime?
  quoteAcceptedAt           DateTime?
  assignedAt                DateTime?
  waitingClientValidationAt DateTime?
  clientValidatedAt         DateTime?
  paymentPendingAt          DateTime?
  paidAt                    DateTime?
  invoiceSentAt             DateTime?

  // Artisan workflow timestamps
  artisanAcceptedAt DateTime?
  artisanRejectedAt DateTime?
  artisanOnTheWayAt DateTime?
  artisanArrivedAt  DateTime?
  workStartedAt     DateTime?
  workCompletedAt   DateTime?
  cancelledAt       DateTime?

  // Artisan mission details
  diagnosticNotes String?
  materialUsed    Json?

  // Extra quote request by artisan
  extraQuoteRequested Boolean @default(false)
  extraQuoteReason    String?

  // Client signature collected by artisan
  clientSignatureUrl String?
  clientSignatureAt  DateTime?

  // Artisan problem report
  problemReported Boolean             @default(false)
  problemType     MissionProblemType?
  problemNotes    String?

  // Status tracking
  lastStatusChangedAt DateTime?

  // Admin management
  adminInternalNotes String?
  cancelledReason    String?
  cancelledById      Int?

  // Relations
  events     InterventionEvent[]
  quotes     Quote[]
  payments   Payment[]
  invoice    Invoice?
  complaints Complaint[]
  messages   Message[]
  review     Review?

  missionRejections ArtisanMissionRejection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([artisanId])
  @@index([status])
  @@index([serviceType])
  @@index([subServiceId])
  @@index([urgency])
  @@index([createdAt])
  @@index([contactPhone])
  @@index([contactEmail])
  @@index([lastStatusChangedAt])
  @@index([requestCreatedAt])
  @@index([adminReviewStartedAt])
  @@index([quoteSentAt])
  @@index([quoteAcceptedAt])
  @@index([assignedAt])
  @@index([workStartedAt])
  @@index([workCompletedAt])
  @@index([paymentPendingAt])
  @@index([paidAt])
  @@index([invoiceSentAt])
  @@index([cancelledById])
}

model InterventionEvent {
  id             Int          @id @default(autoincrement())
  interventionId Int
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  type        InterventionEventType
  title       String
  message     String?
  createdById Int?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([interventionId])
  @@index([type])
  @@index([createdAt])
  @@index([createdById])
}

// ==========================================================
// Quotes
// ==========================================================

model Quote {
  id             Int          @id @default(autoincrement())
  interventionId Int
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  // Admin, support, dispatcher, or artisan who created the quote
  createdById Int?
  createdBy   User? @relation("QuotesCreated", fields: [createdById], references: [id])

  title       String
  description String?

  // Financial totals
  amountHT  Float
  taxRate   Float @default(20)
  taxAmount Float
  amountTTC Float

  // Quote lifecycle
  status     QuoteStatus @default(DRAFT)
  clientNote String?
  pdfUrl     String?
  expiresAt  DateTime?

  sentAt      DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  expiredAt   DateTime?
  cancelledAt DateTime?

  items    QuoteItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([interventionId])
  @@index([createdById])
  @@index([status])
  @@index([expiresAt])
  @@index([sentAt])
  @@index([acceptedAt])
  @@index([rejectedAt])
  @@index([expiredAt])
  @@index([cancelledAt])
  @@index([createdAt])
}

model QuoteItem {
  id      Int   @id @default(autoincrement())
  quoteId Int
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  label       String
  description String?
  quantity    Float  @default(1)
  unitPrice   Float
  total       Float

  @@index([quoteId])
}

// ==========================================================
// Payments - no external API for now
// ==========================================================

model Payment {
  id             Int          @id @default(autoincrement())
  interventionId Int
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  quoteId Int?
  quote   Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  method   PaymentMethod
  provider PaymentProvider @default(MANUAL)

  status PaymentStatus @default(PENDING)

  amount         Float
  amountRefunded Float  @default(0)
  currency       String @default("EUR")

  reference         String?
  providerPaymentId String?

  receiptNumber      String?   @unique
  receiptUrl         String?
  receiptGeneratedAt DateTime?

  clientNote String?
  adminNote  String?

  failureReason String?
  refundReason  String?

  createdById   Int?
  confirmedById Int?
  refundedById  Int?

  requestedAt DateTime @default(now())
  confirmedAt DateTime?
  failedAt    DateTime?
  refundedAt  DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([interventionId])
  @@index([quoteId])
  @@index([invoiceId])
  @@index([method])
  @@index([provider])
  @@index([status])
  @@index([reference])
  @@index([providerPaymentId])
  @@index([receiptNumber])
  @@index([createdById])
  @@index([confirmedById])
  @@index([refundedById])
  @@index([requestedAt])
  @@index([confirmedAt])
  @@index([failedAt])
  @@index([refundedAt])
  @@index([cancelledAt])
  @@index([createdAt])
}

// ==========================================================
// Invoices
// ==========================================================

model Invoice {
  id             Int          @id @default(autoincrement())
  interventionId Int          @unique
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)

  // Payment status snapshot
  paymentStatus PaymentStatus @default(PENDING)

  // Company information snapshot
  companyName    String?
  companyPhone   String?
  companyEmail   String?
  companyAddress String?
  companyTaxId   String?
  companyWebsite String?

  // Client information snapshot
  clientName    String?
  clientEmail   String?
  clientPhone   String?
  clientAddress String?

  // Intervention details snapshot
  interventionDescription String?
  interventionAddress     String?
  serviceType             ServiceType?
  subServiceName          String?

  // Financial totals
  amountHT  Float
  taxRate   Float @default(20)
  taxAmount Float
  amountTTC Float

  // PDF / email
  pdfUrl    String?
  emailedTo String?

  notes        String?
  cancelReason String?

  issuedAt    DateTime?
  sentAt      DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([interventionId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([issuedAt])
  @@index([sentAt])
  @@index([paidAt])
  @@index([cancelledAt])
  @@index([createdAt])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  label       String
  description String?
  quantity    Float  @default(1)
  unitPrice   Float
  total       Float

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ==========================================================
// Support / Messages / Reviews
// ==========================================================

model Complaint {
  id             Int          @id @default(autoincrement())
  interventionId Int
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  assignedToId Int?

  title       String
  description String
  status      ComplaintStatus @default(OPEN)

  refundRequested Boolean @default(false)
  refundApproved  Boolean @default(false)
  refundAmount    Float?
  refundDecidedAt DateTime?

  adminNotes    String?
  internalNotes String?
  attachments   String[]

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([interventionId])
  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
}

model Message {
  id             Int          @id @default(autoincrement())
  interventionId Int
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  senderId Int
  sender   User @relation("SentMessages", fields: [senderId], references: [id])

  audience    MessageAudience
  content     String
  attachments String[]
  isRead      Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([interventionId])
  @@index([senderId])
  @@index([audience])
  @@index([isRead])
  @@index([createdAt])
}

model Review {
  id             Int          @id @default(autoincrement())
  interventionId Int          @unique
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  clientId Int
  client   User @relation("ReviewsGiven", fields: [clientId], references: [id])

  artisanId Int?
  artisan   User? @relation("ReviewsReceived", fields: [artisanId], references: [id])

  rating         Int
  isOnTime       Boolean?
  comment        String?
  wouldRecommend Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([artisanId])
  @@index([rating])
  @@index([createdAt])
}

// ==========================================================
// Artisan Profile / Onboarding / Mobile App
// ==========================================================

model ArtisanProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialty       String?
  specialties     String[]
  yearsExperience Int      @default(0)

  companyName     String?
  companyNumber   String?
  insuranceNumber String?

  bio             String?
  profilePhotoUrl String?

  verificationStatus ArtisanVerificationStatus @default(DRAFT)
  rejectionReason    String?
  verifiedAt         DateTime?
  verifiedById       Int?

  availabilityStatus ArtisanAvailabilityStatus @default(OFFLINE)
  isAcceptingJobs    Boolean                   @default(false)

  lastSeenAt DateTime?

  averageRating      Float @default(0)
  completedJobsCount Int   @default(0)
  cancelledJobsCount Int   @default(0)

  documents    ArtisanDocument[]
  serviceZones ArtisanServiceZone[]
  availability ArtisanAvailabilitySlot[]
  bankDetails  ArtisanBankDetails?

  missionRejections ArtisanMissionRejection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
  @@index([availabilityStatus])
  @@index([isAcceptingJobs])
  @@index([lastSeenAt])
}

model ArtisanDocument {
  id               Int            @id @default(autoincrement())
  artisanProfileId Int
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)

  type     ArtisanDocumentType
  fileUrl  String
  fileName String?
  mimeType String?

  status        ArtisanDocumentStatus @default(PENDING)
  rejectionNote String?

  uploadedAt   DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById Int?

  @@index([artisanProfileId])
  @@index([type])
  @@index([status])
  @@index([uploadedAt])
}

model ArtisanServiceZone {
  id               Int            @id @default(autoincrement())
  artisanProfileId Int
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)

  label      String?
  city       String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  radiusKm   Float   @default(10)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artisanProfileId])
  @@index([isActive])
  @@index([postalCode])
  @@index([city])
}

model ArtisanAvailabilitySlot {
  id               Int            @id @default(autoincrement())
  artisanProfileId Int
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek
  startTime String
  endTime   String

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artisanProfileId])
  @@index([dayOfWeek])
}

model ArtisanBankDetails {
  id               Int            @id @default(autoincrement())
  artisanProfileId Int            @unique
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)

  accountHolderName String?
  bankName          String?
  iban              String?
  bic               String?

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArtisanMissionRejection {
  id               Int            @id @default(autoincrement())
  artisanProfileId Int
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)

  interventionId Int
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  reason MissionRejectionReason
  note   String?

  createdAt DateTime @default(now())

  @@index([artisanProfileId])
  @@index([interventionId])
  @@index([reason])
}

// ==========================================================
// Admin Dashboard / Settings / Internal Notes
// ==========================================================

model AdminInternalNote {
  id Int @id @default(autoincrement())

  targetType AdminNoteTargetType
  targetId   Int

  authorId Int?
  content  String

  createdAt DateTime @default(now())

  @@index([targetType])
  @@index([targetId])
  @@index([authorId])
  @@index([createdAt])
}

model CompanySettings {
  id Int @id @default(autoincrement())

  companyName  String?
  companyPhone String?
  companyEmail String?

  smsSender String?

  defaultTaxRate      Float @default(20)
  defaultEmergencyFee Float @default(0)

  openingHours Json?

  paymentMethods String[]

  termsAndConditions String?
  privacyPolicy      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminServiceZone {
  id Int @id @default(autoincrement())

  name       String
  city       String?
  postalCode String?

  latitude  Float?
  longitude Float?
  radiusKm  Float @default(10)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([postalCode])
  @@index([isActive])
}

model NotificationTemplate {
  id Int @id @default(autoincrement())

  key     String                   @unique
  type    NotificationTemplateType
  subject String?
  content String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([type])
  @@index([isActive])
}

// ==========================================================
// Artisan Applications
// ==========================================================

model ArtisanApplication {
  id          Int    @id @default(autoincrement())
  name        String
  email       String @unique
  phone       String
  specialty   String
  experience  Int
  description String?

  status ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}