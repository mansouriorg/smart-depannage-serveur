// ==========================================================
// Quotes
// ==========================================================

model Quote {
  id             Int          @id @default(autoincrement())
  interventionId Int
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  createdById Int?
  createdBy   User? @relation("QuotesCreated", fields: [createdById], references: [id])

  title       String
  description String?

  // The currency the amounts were written in: the one of the company when the document was made (P2-01).
  currency String @default("TND")

  amountHT  Decimal @db.Decimal(14, 3)
  taxRate   Decimal @db.Decimal(5, 2) @default(19)
  taxAmount Decimal @db.Decimal(14, 3)
  amountTTC Decimal @db.Decimal(14, 3)

  status     QuoteStatus @default(DRAFT)
  clientNote String?
  pdfUrl     String?
  expiresAt  DateTime?

  // The version of the content (title, description, lines, tax rate, amounts, PDF) the customer is shown (P2-04). It goes up each time a
  // quote that was sent is edited; the versions it replaced are kept in QuoteRevision.
  revision Int @default(1)

  sentAt      DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  expiredAt   DateTime?
  cancelledAt DateTime?

  items     QuoteItem[]
  payments  Payment[]
  revisions QuoteRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([interventionId])
  @@index([createdById])
  @@index([status])
  @@index([expiresAt])
  @@index([sentAt])
  @@index([acceptedAt])
  @@index([rejectedAt])
  @@index([expiredAt])
  @@index([cancelledAt])
  @@index([createdAt])
}

// A version of a quote that an edit replaced (P2-04): what the customer could have seen and accepted before the edit.
model QuoteRevision {
  id      Int   @id @default(autoincrement())
  quoteId Int
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  // The number of the version that was replaced (1 is the quote as it was first sent).
  revision Int

  // The status the quote had when it was replaced.
  status QuoteStatus

  title       String
  description String?
  currency    String @default("TND")

  // The PDF that version had, if any: what the customer downloads is part of what they read.
  pdfUrl String?

  amountHT  Decimal @db.Decimal(14, 3)
  taxRate   Decimal @db.Decimal(5, 2)
  taxAmount Decimal @db.Decimal(14, 3)
  amountTTC Decimal @db.Decimal(14, 3)

  // The lines of that version: [{ label, description, quantity, unitPrice, total }].
  items Json

  // Who made the edit that replaced it.
  savedById Int?
  savedAt   DateTime @default(now())

  @@unique([quoteId, revision])
  @@index([quoteId])
}

model QuoteItem {
  id      Int   @id @default(autoincrement())
  quoteId Int
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  label       String
  description String?
  quantity    Float  @default(1)
  unitPrice   Decimal @db.Decimal(14, 3)
  total       Decimal @db.Decimal(14, 3)

  @@index([quoteId])
}

// ==========================================================
// Payments
// ==========================================================

model Payment {
  id             Int          @id @default(autoincrement())
  interventionId Int
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  quoteId Int?
  quote   Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  method   PaymentMethod
  provider PaymentProvider @default(MANUAL)

  status PaymentStatus @default(PENDING)

  amount         Decimal @db.Decimal(14, 3)
  amountRefunded Decimal @db.Decimal(14, 3) @default(0)
  currency       String @default("TND")

  reference         String?
  providerPaymentId String?

  // Card payments (P2-10). `payUrl` is the page of the provider where the customer pays, `expiresAt` when an unpaid card payment
  // lapses. `idempotencyKey` is the key the caller sent with the request (scoped to the caller): the same key is the same payment.
  // `gatewayClaimedAt` marks the moment someone asked the provider for this payment (one asker at a time), `providerCheckedAt` the
  // last time the provider was asked what became of it, `moneySeenAt` the moment the provider first said money had come on a payment
  // that could not be counted by itself (it was put in front of the team): when the team closes such a payment, a later sighting of
  // the same money does not open it again.
  payUrl            String?
  expiresAt         DateTime?
  idempotencyKey    String? @unique
  gatewayClaimedAt  DateTime?
  providerCheckedAt DateTime?
  moneySeenAt       DateTime?

  receiptNumber      String? @unique
  receiptUrl         String?
  receiptGeneratedAt DateTime?

  clientNote String?
  adminNote  String?

  failureReason String?
  cancelReason  String?
  refundReason  String?

  createdById   Int?
  confirmedById Int?
  refundedById  Int?

  requestedAt DateTime @default(now())
  confirmedAt DateTime?
  failedAt    DateTime?
  refundedAt  DateTime?
  cancelledAt DateTime?

  cashLedgerEntries CashLedgerEntry[]
  refunds           PaymentRefund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([interventionId])
  @@index([quoteId])
  @@index([invoiceId])
  @@index([method])
  @@index([provider])
  @@index([status])
  @@index([reference])
  @@index([providerPaymentId])
  @@index([receiptNumber])
  @@index([createdById])
  @@index([confirmedById])
  @@index([refundedById])
  @@index([requestedAt])
  @@index([confirmedAt])
  @@index([failedAt])
  @@index([refundedAt])
  @@index([cancelledAt])
  @@index([createdAt])
  /// A provider's number names one payment (a notification is looked up by it); payments with none (cash, transfers, empty requests) do not meet.
  @@unique([provider, providerPaymentId])
}

/// Each refund of a payment, one row per refund (P2-10). `idempotencyKey` is the key the back office sent with the request: the same key
/// is the same refund, so a second click or a retry gives the money back once.
model PaymentRefund {
  id        Int     @id @default(autoincrement())
  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(14, 3)
  reason String?

  idempotencyKey String? @unique

  createdById Int?
  createdAt   DateTime @default(now())

  @@index([paymentId])
  @@index([createdAt])
}

/// What the payment provider told us and what became of it (P2-10): one row per call to the webhook, kept for the support. Nothing
/// reads it to decide anything.
model PaymentWebhookLog {
  id                Int             @id @default(autoincrement())
  provider          PaymentProvider
  providerPaymentId String
  paymentId         Int?
  /// CONFIRMED, ALREADY, PENDING, FAILED, EXPIRED, REVIEW, UNKNOWN or UNREACHABLE.
  outcome           String
  receivedAt        DateTime        @default(now())

  @@index([providerPaymentId])
  @@index([paymentId])
  @@index([receivedAt])
}

// ==========================================================
// Invoices
// ==========================================================

model Invoice {
  id             Int          @id @default(autoincrement())
  interventionId Int
  // Restrict, not Cascade (P2-07): an invoice is a legal document with a number in a series without gaps. Deleting its job must not
  // delete it quietly (and leave a gap that the audit would flag); the job is closed or cancelled, not removed.
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Restrict)

  invoiceNumber String        @unique
  // The number is taken from a counter, in order and without gaps (P2-07): the year and the rank in that year.
  // Invoices numbered before the counter existed have neither.
  numberYear Int?
  sequence   Int?
  status        InvoiceStatus @default(DRAFT)

  paymentStatus PaymentStatus @default(PENDING)

  companyName    String?
  companyPhone   String?
  companyEmail   String?
  companyAddress String?
  companyTaxId   String?
  companyWebsite String?

  // What the invoice printed on the day it was issued, kept so that it reads the same later (P2-07).
  companyRegistre   String?
  legalMentions     String?
  paymentTerms      String?
  // The bank account (RIB) printed on an invoice that is not paid yet.
  companyRib        String?
  // The stamp duty (timbre fiscal) added to the total to pay; 0 when none.
  stampDuty         Decimal @db.Decimal(14, 3) @default(0)
  // Whether the accountant had confirmed the mentions, the VAT rates and the stamp duty when the invoice was issued.
  mentionsConfirmed Boolean @default(false)

  clientName    String?
  clientEmail   String?
  clientPhone   String?
  clientAddress String?
  // The matricule fiscal of a customer that is a business (printed when there is one).
  clientTaxId   String?

  interventionDescription String?
  interventionAddress     String?
  serviceType             ServiceType?
  subServiceName          String?

  // The currency the amounts were written in: the one of the company when the document was made (P2-01).
  currency String @default("TND")

  amountHT  Decimal @db.Decimal(14, 3)
  taxRate   Decimal @db.Decimal(5, 2) @default(19)
  taxAmount Decimal @db.Decimal(14, 3)
  amountTTC Decimal @db.Decimal(14, 3)

  // What the credit notes took off (the total and the stamp duty): the amount to pay is the total, plus the stamp duty, less this.
  creditedAmount Decimal @db.Decimal(14, 3) @default(0)

  pdfUrl    String?
  emailedTo String?

  notes        String?
  cancelReason String?

  issuedAt    DateTime?
  sentAt      DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       InvoiceItem[]
  payments    Payment[]
  creditNotes CreditNote[]

  @@unique([numberYear, sequence])
  @@index([interventionId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([issuedAt])
  @@index([sentAt])
  @@index([paidAt])
  @@index([cancelledAt])
  @@index([createdAt])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  label       String
  description String?
  quantity    Float @default(1)
  unitPrice   Decimal @db.Decimal(14, 3)
  total       Decimal @db.Decimal(14, 3)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// A credit note (avoir): the document that takes back all or part of an invoice that was issued. It has its own series of
// numbers, in order and without gaps, and it is never deleted (P2-07).
model CreditNote {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  interventionId Int

  creditNoteNumber String @unique
  numberYear       Int
  sequence         Int

  // Printed on the credit note: the customer reads it.
  reason String

  currency  String  @default("TND")
  amountHT  Decimal @db.Decimal(14, 3)
  taxRate   Decimal @db.Decimal(5, 2)
  taxAmount Decimal @db.Decimal(14, 3)
  amountTTC Decimal @db.Decimal(14, 3)
  // The part of the invoice's stamp duty this credit note takes back (all of it when the credit note closes the invoice).
  stampDuty Decimal @db.Decimal(14, 3) @default(0)

  createdById Int?
  issuedAt    DateTime @default(now())

  createdAt DateTime @default(now())

  @@unique([numberYear, sequence])
  @@index([invoiceId])
  @@index([interventionId])
  @@index([issuedAt])
}

// The last number given in a series for a year (P2-07): INVOICE or CREDIT_NOTE. A number is taken under a lock, in the
// transaction that writes the document, so that a document that fails to save does not use up a number.
model DocumentCounter {
  id     Int    @id @default(autoincrement())
  series String
  year   Int
  last   Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([series, year])
}

// ==========================================================
// Files / Local Storage
// ==========================================================

model FileAsset {
  id Int @id @default(autoincrement())

  uploadedById Int?
  uploadedBy   User? @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: SetNull)

  purpose    FileAssetPurpose
  visibility FileAssetVisibility @default(PRIVATE)

  storageProvider StorageProvider @default(LOCAL)

  entityType String?
  entityId   Int?

  originalName String
  fileName     String
  relativePath String
  publicUrl    String?

  mimeType  String
  extension String?
  size      Int

  checksum String?

  isImage Boolean @default(false)
  width   Int?
  height  Int?

  isDeleted Boolean @default(false)
  deletedAt DateTime?

  replacedById Int?
  replacedBy   FileAsset?  @relation("FileReplacement", fields: [replacedById], references: [id])
  replacements FileAsset[] @relation("FileReplacement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploadedById])
  @@index([purpose])
  @@index([visibility])
  @@index([storageProvider])
  @@index([entityType])
  @@index([entityId])
  @@index([entityType, entityId])
  @@index([mimeType])
  @@index([isDeleted])
  @@index([createdAt])
}

// ==========================================================
// Support / Messages / Reviews
// ==========================================================

model Complaint {
  id             Int          @id @default(autoincrement())
  interventionId Int
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  assignedToId Int?
  assignedTo   User? @relation("AssignedComplaints", fields: [assignedToId], references: [id], onDelete: SetNull)

  title       String
  description String

  photos      String[] @default([])
  attachments String[] @default([])

  status ComplaintStatus @default(OPEN)

  clientMessage      String?
  artisanResponse    String?
  artisanRespondedAt DateTime?

  adminDecision     ComplaintDecision?
  adminDecisionNote String?
  adminDecisionById Int?
  adminDecisionAt   DateTime?

  refundRequested   Boolean                 @default(false)
  refundDecision    ComplaintRefundDecision @default(NOT_REQUESTED)
  refundApproved    Boolean                 @default(false)
  refundAmount      Decimal? @db.Decimal(14, 3)
  refundDecidedById Int?
  refundDecidedAt   DateTime?

  resolutionNotes String?
  resolvedAt      DateTime?
  rejectedAt      DateTime?
  closedAt        DateTime?

  adminNotes    String?
  internalNotes String?

  messages ComplaintMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([interventionId])
  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@index([refundRequested])
  @@index([refundDecision])
  @@index([refundApproved])
  @@index([adminDecision])
  @@index([createdAt])
  @@index([closedAt])
}

model ComplaintMessage {
  id Int @id @default(autoincrement())

  complaintId Int
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  senderId Int?
  sender   User? @relation("ComplaintMessageAuthor", fields: [senderId], references: [id], onDelete: SetNull)

  senderRole Role

  content     String
  attachments String[] @default([])

  isInternal Boolean @default(false)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complaintId])
  @@index([senderId])
  @@index([senderRole])
  @@index([isInternal])
  @@index([deletedAt])
  @@index([createdAt])
}

model Message {
  id             Int          @id @default(autoincrement())
  interventionId Int
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  senderId Int
  sender   User @relation("SentMessages", fields: [senderId], references: [id])

  audience MessageAudience

  content String?

  attachments String[]

  isRead Boolean @default(false)

  readByUserIds Int[] @default([])

  readAt    DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([interventionId])
  @@index([senderId])
  @@index([audience])
  @@index([isRead])
  @@index([readAt])
  @@index([deletedAt])
  @@index([createdAt])
}

model Review {
  id             Int          @id @default(autoincrement())
  interventionId Int          @unique
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  clientId Int
  client   User @relation("ReviewsGiven", fields: [clientId], references: [id])

  artisanId Int?
  artisan   User? @relation("ReviewsReceived", fields: [artisanId], references: [id])

  rating Int

  comment          String?
  isOnTime         Boolean?
  isWorkClean      Boolean?
  isPriceRespected Boolean?
  wouldRecommend  Boolean?

  status           ReviewModerationStatus @default(PENDING)
  isVisible        Boolean                @default(false)
  moderatedById    Int?
  moderatedAt      DateTime?
  moderationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([artisanId])
  @@index([rating])
  @@index([status])
  @@index([isVisible])
  @@index([moderatedById])
  @@index([createdAt])
}

// ==========================================================
// Artisan Profile / Onboarding / Mobile App
// ==========================================================

model ArtisanProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialty       String?
  specialties     String[]
  serviceTypes    ServiceType[] @default([])
  yearsExperience Int           @default(0)

  companyName     String?
  companyNumber   String?
  insuranceNumber String?

  bio             String?
  profilePhotoUrl String?

  verificationStatus ArtisanVerificationStatus @default(DRAFT)
  rejectionReason    String?
  verifiedAt         DateTime?
  verifiedById       Int?

  availabilityStatus ArtisanAvailabilityStatus @default(OFFLINE)
  isAcceptingJobs    Boolean                   @default(false)

  emergencyAvailable     Boolean @default(false)
  maxActiveJobs          Int     @default(3)
  averageResponseMinutes Int?

  lastSeenAt DateTime?

  averageRating      Float @default(0)
  ratingCount        Int   @default(0)
  completedJobsCount Int   @default(0)
  cancelledJobsCount Int   @default(0)

  documents    ArtisanDocument[]
  serviceZones ArtisanServiceZone[]
  availability ArtisanAvailabilitySlot[]
  bankDetails  ArtisanBankDetails?

  missionRejections ArtisanMissionRejection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
  @@index([availabilityStatus])
  @@index([isAcceptingJobs])
  @@index([emergencyAvailable])
  @@index([maxActiveJobs])
  @@index([averageRating])
  @@index([ratingCount])
  @@index([lastSeenAt])
}

model ArtisanDocument {
  id               Int            @id @default(autoincrement())
  artisanProfileId Int
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)

  type     ArtisanDocumentType
  fileUrl  String
  fileName String?
  mimeType String?

  status        ArtisanDocumentStatus @default(PENDING)
  rejectionNote String?

  uploadedAt   DateTime @default(now())
  reviewedAt   DateTime?
  reviewedById Int?

  @@index([artisanProfileId])
  @@index([type])
  @@index([status])
  @@index([uploadedAt])
}

model ArtisanServiceZone {
  id               Int            @id @default(autoincrement())
  artisanProfileId Int
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)

  label      String?
  city       String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  radiusKm   Float @default(10)

  // The zone of the platform this one was taken from (P1-11). The coordinates and the radius are
  // copied, so changing the platform zone later does not move an artisan's zone.
  adminZoneId Int?
  adminZone   AdminServiceZone? @relation(fields: [adminZoneId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artisanProfileId])
  @@index([adminZoneId])
  @@index([isActive])
  @@index([postalCode])
  @@index([city])
}

model ArtisanAvailabilitySlot {
  id               Int            @id @default(autoincrement())
  artisanProfileId Int
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek
  startTime String
  endTime   String

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artisanProfileId])
  @@index([dayOfWeek])
}

model ArtisanBankDetails {
  id               Int            @id @default(autoincrement())
  artisanProfileId Int            @unique
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)

  accountHolderName String?
  bankName          String?
  iban              String?
  bic               String?

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArtisanMissionRejection {
  id               Int            @id @default(autoincrement())
  artisanProfileId Int
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)

  interventionId Int
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  reason MissionRejectionReason
  note   String?

  createdAt DateTime @default(now())

  @@index([artisanProfileId])
  @@index([interventionId])
  @@index([reason])
}

/// One position a technician's phone sent (P3-05). Kept for a few days (LOCATION_HISTORY_DAYS, 7 by default), longer for a job that has
/// an open complaint, then deleted by the server's daily purge. `interventionId` is the job the technician was on when it was sent
/// (on the way, arrived or at work); it is null for a position sent with no such job, and stays null if the job is deleted.
model ArtisanLocationPing {
  id Int @id @default(autoincrement())

  artisanId Int
  artisan   User @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  interventionId Int?
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  latitude  Float
  longitude Float

  // What the phone said about the reading, when it said it: the radius of doubt in metres, the speed in metres per second (as the phone
  // reports it), the heading in degrees.
  accuracyMeters Float?
  speedMps       Float?
  heading        Float?

  recordedAt DateTime @default(now())

  @@index([artisanId, recordedAt])
  @@index([interventionId, recordedAt])
  @@index([recordedAt])
}

// ==========================================================
// Appointments / Scheduling
// ==========================================================

model Appointment {
  id Int @id @default(autoincrement())

  interventionId Int          @unique
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  clientId Int
  client   User @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)

  artisanId Int?
  artisan   User? @relation("ArtisanAppointments", fields: [artisanId], references: [id], onDelete: SetNull)

  status AppointmentStatus @default(REQUESTED)

  preferredDate      DateTime?
  preferredStartTime String?
  preferredEndTime   String?

  startsAt DateTime?
  endsAt   DateTime?

  timezone String @default("Africa/Tunis")

  clientNote  String?
  adminNote   String?
  artisanNote String?

  scheduledById Int?
  confirmedAt   DateTime?

  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests  AppointmentRequest[]
  reminders AppointmentReminder[]

  @@index([interventionId])
  @@index([clientId])
  @@index([artisanId])
  @@index([status])
  @@index([preferredDate])
  @@index([startsAt])
  @@index([endsAt])
  @@index([scheduledById])
  @@index([createdAt])
  @@index([artisanId, startsAt, endsAt])
}

model AppointmentRequest {
  id Int @id @default(autoincrement())

  appointmentId Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  requestedById Int?

  type   AppointmentRequestType
  status AppointmentRequestStatus @default(PENDING)

  // What the visit was when this was asked (SCHEDULED or CONFIRMED): what a refusal puts back (P3-01). Null on a request made
  // before this column existed: the status is then worked out from the visit (confirmed once the artisan has confirmed it).
  previousStatus AppointmentStatus?

  requestedStartAt DateTime?
  requestedEndAt   DateTime?

  reason        String?
  adminResponse String?

  reviewedById Int?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([requestedById])
  @@index([type])
  @@index([status])
  @@index([requestedStartAt])
  @@index([requestedEndAt])
  @@index([reviewedById])
  @@index([createdAt])
}

model AppointmentReminder {
  id Int @id @default(autoincrement())

  appointmentId Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  recipientId Int?

  minutesBefore Int

  dueAt DateTime

  status AppointmentReminderStatus @default(PENDING)

  sentAt DateTime?
  error  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([recipientId])
  @@index([status])
  @@index([dueAt])
  @@index([sentAt])
  @@index([createdAt])
}

model ArtisanTimeBlock {
  id Int @id @default(autoincrement())

  artisanId Int
  artisan   User @relation("ArtisanTimeBlocks", fields: [artisanId], references: [id], onDelete: Cascade)

  type ArtisanTimeBlockType @default(UNAVAILABLE)

  startsAt DateTime
  endsAt   DateTime

  reason String?

  createdById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artisanId])
  @@index([type])
  @@index([startsAt])
  @@index([endsAt])
  @@index([createdById])
  @@index([createdAt])
  @@index([artisanId, startsAt, endsAt])
}

// ==========================================================
// Business / Revenue / Accounting
// ==========================================================

model InterventionFinancials {
  id Int @id @default(autoincrement())

  interventionId Int          @unique
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  currency String @default("TND")

  totalPrice Decimal @db.Decimal(14, 3)

  commissionRate     Decimal @db.Decimal(5, 2) @default(20)
  platformCommission Decimal @db.Decimal(14, 3)
  artisanPayout      Decimal @db.Decimal(14, 3)
  paymentProviderFee Decimal @db.Decimal(14, 3) @default(0)
  refundAmount       Decimal @db.Decimal(14, 3) @default(0)

  netRevenue    Decimal @db.Decimal(14, 3)
  companyMargin Decimal @db.Decimal(14, 3)

  notes          String?
  calculatedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payoutItems ArtisanPayoutItem[]

  @@index([interventionId])
  @@index([currency])
  @@index([commissionRate])
  @@index([totalPrice])
  @@index([platformCommission])
  @@index([artisanPayout])
  @@index([paymentProviderFee])
  @@index([refundAmount])
  @@index([netRevenue])
  @@index([companyMargin])
  @@index([calculatedById])
  @@index([createdAt])
}

/// One line of the cash an artisan holds for the platform (P2-02). The lines are only ever added, never changed or deleted:
/// a mistake is corrected by another line. Each line says what it does to two figures, signed:
///   - cashAmount: the cash the artisan has taken from customers (a collection adds it, a reversal takes it back);
///   - commissionAmount: what the artisan owes the platform (a collection adds the commission, a remittance takes it off).
/// The balance of an artisan is the sum of commissionAmount. `type` is one of COLLECTION, REMITTANCE, REVERSAL and ADJUSTMENT
/// (a text and not an enum, so that the shared package does not change with it).
model CashLedgerEntry {
  id Int @id @default(autoincrement())

  artisanId Int
  artisan   User @relation("ArtisanCashLedger", fields: [artisanId], references: [id], onDelete: Restrict)

  type String

  interventionId Int?
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  paymentId Int?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  cashAmount       Decimal @db.Decimal(14, 3) @default(0)
  commissionAmount Decimal @db.Decimal(14, 3) @default(0)

  // The rate (percent) the commission of a collection was computed at, kept with the line.
  commissionRate Decimal? @db.Decimal(5, 2)

  currency String @default("TND")

  // The number of a transfer or of a receipt (a remittance), and the words of the person who typed the line.
  reference String?
  note      String?

  // The line that this one takes back (a reversal): a line is taken back once.
  reversesId Int? @unique

  // The caller's own key for the request, so that sending it twice writes one line.
  requestKey String?

  recordedById Int?

  createdAt DateTime @default(now())

  @@unique([artisanId, requestKey])
  @@index([artisanId, createdAt])
  @@index([interventionId])
  @@index([paymentId])
  @@index([type])
}

